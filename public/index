<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
<title>Beacon — Real-Time Disaster Rescue & Emergency Coordination</title>
<meta name="description" content="Mission-critical disaster rescue coordination platform connecting trapped or injured victims with verified volunteer responders in real time." />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- Leaflet CSS & JS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>

<!-- Socket.io Client -->
<script src="/socket.io/socket.io.js"></script>

<style>
  /* ==========================================================================
     CSS VARIABLES & DESIGN SYSTEM
     ========================================================================== */
  :root {
    --font-main: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    --font-body: 'Inter', sans-serif;

    /* Theme: Dark Tactical (Default) */
    --bg-base: #090D14;
    --bg-surface: #101623;
    --bg-surface-elevated: #162032;
    --bg-surface-hover: #1E2B42;
    --border-subtle: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(255, 255, 255, 0.16);
    --border-focus: #3B82F6;

    --text-primary: #F8FAFC;
    --text-secondary: #94A3B8;
    --text-muted: #64748B;

    /* Emergency Accents */
    --sos-crimson: #EF4444;
    --sos-crimson-dim: rgba(239, 68, 68, 0.14);
    --sos-crimson-glow: rgba(239, 68, 68, 0.35);

    --safe-emerald: #10B981;
    --safe-emerald-dim: rgba(16, 185, 129, 0.14);
    --safe-emerald-glow: rgba(16, 185, 129, 0.35);

    --warn-amber: #F59E0B;
    --warn-amber-dim: rgba(245, 158, 11, 0.14);

    --signal-blue: #3B82F6;
    --signal-blue-dim: rgba(59, 130, 246, 0.14);

    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --radius-pill: 9999px;

    --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.35);
    --shadow-card: 0 8px 32px rgba(0, 0, 0, 0.45);
    --shadow-glow-crimson: 0 0 28px rgba(239, 68, 68, 0.45);
    --shadow-glow-emerald: 0 0 24px rgba(16, 185, 129, 0.35);

    --transition-fast: 0.16s ease;
    --transition-norm: 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-theme="light"] {
    --bg-base: #F4F6F9;
    --bg-surface: #FFFFFF;
    --bg-surface-elevated: #F8FAFC;
    --bg-surface-hover: #F1F5F9;
    --border-subtle: rgba(0, 0, 0, 0.08);
    --border-strong: rgba(0, 0, 0, 0.16);
    --border-focus: #2563EB;

    --text-primary: #0F172A;
    --text-secondary: #475569;
    --text-muted: #64748B;

    --sos-crimson: #DC2626;
    --sos-crimson-dim: rgba(220, 38, 38, 0.1);
    --sos-crimson-glow: rgba(220, 38, 38, 0.25);

    --safe-emerald: #059669;
    --safe-emerald-dim: rgba(5, 150, 105, 0.1);
    --safe-emerald-glow: rgba(5, 150, 105, 0.25);

    --warn-amber: #D97706;
    --warn-amber-dim: rgba(217, 119, 6, 0.1);

    --signal-blue: #2563EB;
    --signal-blue-dim: rgba(37, 99, 235, 0.1);

    --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.06);
    --shadow-card: 0 8px 30px rgba(0, 0, 0, 0.08);
    --shadow-glow-crimson: 0 0 24px rgba(220, 38, 38, 0.25);
    --shadow-glow-emerald: 0 0 20px rgba(5, 150, 105, 0.2);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    min-height: 100vh;
    background-color: var(--bg-base);
    color: var(--text-primary);
    font-family: var(--font-main);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    line-height: 1.5;
  }

  .page-wrapper {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    background: radial-gradient(circle at 50% 0%, rgba(59, 130, 246, 0.06) 0%, transparent 60%);
  }

  #app-container {
    width: 100%;
    max-width: 640px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg-surface);
    border-left: 1px solid var(--border-subtle);
    border-right: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-card);
    position: relative;
    transition: max-width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  #app-container.wide-mode { max-width: 1180px; }

  /* TOP BAR & NAVIGATION */
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(16, 22, 35, 0.88);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  [data-theme="light"] .top-bar { background: rgba(255, 255, 255, 0.9); }

  .brand-group { display: flex; align-items: center; gap: 12px; cursor: pointer; }
  .brand-logo-radar {
    width: 38px; height: 38px; border-radius: 10px;
    background: linear-gradient(135deg, var(--sos-crimson) 0%, #B91C1C 100%);
    display: flex; align-items: center; justify-content: center; color: #fff;
    position: relative; box-shadow: 0 0 16px var(--sos-crimson-glow);
  }
  .brand-logo-radar::after {
    content: ''; position: absolute; inset: -3px; border-radius: 13px;
    border: 1px solid var(--sos-crimson); opacity: 0.6;
    animation: radarPing 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes radarPing {
    0% { transform: scale(1); opacity: 0.8; }
    80%, 100% { transform: scale(1.4); opacity: 0; }
  }

  .brand-title { font-weight: 800; font-size: 18px; letter-spacing: -0.4px; display: flex; align-items: center; gap: 8px; }
  .brand-badge {
    font-size: 10px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase;
    background: var(--sos-crimson-dim); color: var(--sos-crimson); padding: 2px 7px;
    border-radius: var(--radius-pill); border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .top-actions { display: flex; align-items: center; gap: 6px; }

  .icon-btn {
    width: 36px; height: 36px; border-radius: 10px; border: 1px solid var(--border-subtle);
    background: var(--bg-surface-elevated); color: var(--text-secondary);
    display: flex; align-items: center; justify-content: center; cursor: pointer; transition: var(--transition-fast);
  }
  .icon-btn:hover { background: var(--bg-surface-hover); color: var(--text-primary); border-color: var(--border-strong); }
  .icon-btn.active { background: var(--sos-crimson); color: #fff; border-color: var(--sos-crimson); }

  .pill-btn {
    font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: var(--radius-pill);
    border: 1px solid var(--border-subtle); background: var(--bg-surface-elevated); color: var(--text-secondary);
    cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: var(--transition-fast); text-decoration: none;
  }
  .pill-btn:hover { border-color: var(--border-strong); color: var(--text-primary); }
  .pill-btn.primary { background: var(--signal-blue-dim); color: var(--signal-blue); border-color: rgba(59, 130, 246, 0.3); }

  /* NAVIGATION MENU BAR */
  .nav-menu-bar {
    background: var(--bg-surface-elevated); border-bottom: 1px solid var(--border-subtle);
    padding: 8px 16px; display: flex; gap: 10px; overflow-x: auto; white-space: nowrap;
  }
  .nav-tab {
    font-size: 13px; font-weight: 600; color: var(--text-secondary); padding: 6px 12px;
    border-radius: var(--radius-pill); cursor: pointer; border: 1px solid transparent; transition: var(--transition-fast);
  }
  .nav-tab:hover { color: var(--text-primary); background: var(--bg-surface-hover); }
  .nav-tab.active { background: var(--signal-blue-dim); color: var(--signal-blue); border-color: rgba(59, 130, 246, 0.3); }

  /* TELEMETRY BAR */
  .telemetry-bar {
    background: var(--bg-base); border-bottom: 1px solid var(--border-subtle);
    padding: 6px 16px; font-size: 11px; font-family: var(--font-mono); color: var(--text-muted);
    display: flex; align-items: center; justify-content: space-between; overflow-x: auto; white-space: nowrap; gap: 12px;
  }
  .live-dot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--safe-emerald);
    box-shadow: 0 0 8px var(--safe-emerald); animation: livePulse 2s ease infinite; display: inline-block;
  }
  @keyframes livePulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.85); } }

  /* SCREENS & CARDS */
  .screen { flex: 1; display: flex; flex-direction: column; padding: 24px 20px 80px; gap: 20px; animation: fadeInScreen 0.25s ease; }
  @keyframes fadeInScreen { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  .hidden { display: none !important; }

  h1.screen-title { font-size: 28px; font-weight: 800; letter-spacing: -0.6px; line-height: 1.2; color: var(--text-primary); }
  h2.section-heading { font-size: 18px; font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 8px; }
  p.screen-lede { font-size: 14px; color: var(--text-secondary); line-height: 1.6; }

  /* RESCUED BANNER ON HOMEPAGE */
  .rescued-counter-banner {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(16, 22, 35, 0.9) 100%);
    border: 1px solid rgba(16, 185, 129, 0.35); border-radius: var(--radius-lg); padding: 20px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px; box-shadow: var(--shadow-glow-emerald);
  }
  .rescued-number { font-size: 38px; font-weight: 800; font-family: var(--font-mono); color: var(--safe-emerald); line-height: 1; }
  .rescued-text { font-size: 13px; color: var(--text-secondary); }

  /* HERO & CHOICE CARDS */
  .hero-banner {
    position: relative; border-radius: var(--radius-lg);
    background: linear-gradient(145deg, rgba(239, 68, 68, 0.12) 0%, rgba(16, 22, 35, 0.85) 100%);
    border: 1px solid rgba(239, 68, 68, 0.28); padding: 24px; overflow: hidden;
  }
  .crisis-pulse-tag {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: var(--radius-pill);
    background: var(--sos-crimson); color: #fff; font-size: 11px; font-weight: 700; text-transform: uppercase; margin-bottom: 12px;
  }

  .choice-container { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 768px) { .wide-mode .choice-container { grid-template-columns: 1fr 1fr; } }

  .choice-card-pro {
    background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);
    padding: 22px; cursor: pointer; text-align: left; transition: all var(--transition-norm); color: var(--text-primary);
  }
  .choice-card-pro:hover { transform: translateY(-3px); border-color: var(--border-strong); box-shadow: var(--shadow-soft); }
  .choice-card-pro.sos-card { background: linear-gradient(180deg, rgba(239, 68, 68, 0.16) 0%, var(--bg-surface-elevated) 80%); border-color: rgba(239, 68, 68, 0.4); }
  .choice-card-pro.rescuer-card-entry { background: linear-gradient(180deg, rgba(16, 185, 129, 0.12) 0%, var(--bg-surface-elevated) 80%); border-color: rgba(16, 185, 129, 0.35); }

  .choice-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .choice-icon-wrap { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
  .sos-card .choice-icon-wrap { background: var(--sos-crimson); color: #fff; }
  .rescuer-card-entry .choice-icon-wrap { background: var(--safe-emerald); color: #fff; }
  .choice-title { font-size: 18px; font-weight: 800; margin-bottom: 6px; }
  .choice-desc { font-size: 13.5px; color: var(--text-secondary); line-height: 1.55; }

  /* FEATURE GRID */
  .feature-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 640px) { .feature-grid { grid-template-columns: 1fr 1fr; } }
  .feature-card {
    background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    padding: 20px; display: flex; flex-direction: column; gap: 10px;
  }
  .feature-icon { width: 40px; height: 40px; border-radius: 10px; background: var(--signal-blue-dim); color: var(--signal-blue); display: flex; align-items: center; justify-content: center; font-size: 20px; }

  /* CONTRIBUTIONS & IMPACT CARDS */
  .impact-hero-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .impact-stat-card {
    background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    padding: 16px; text-align: center;
  }
  .impact-stat-number { font-size: 26px; font-weight: 800; font-family: var(--font-mono); color: var(--signal-blue); }
  .impact-stat-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; margin-top: 4px; }

  .disaster-event-card {
    background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);
    overflow: hidden; display: flex; flex-direction: column; gap: 14px; padding-bottom: 16px;
  }
  .disaster-image-holder { width: 100%; height: 200px; position: relative; overflow: hidden; background: #000; }
  .disaster-image-holder img { width: 100%; height: 100%; object-fit: cover; }
  .disaster-badge { position: absolute; top: 12px; left: 12px; background: rgba(0,0,0,0.75); backdrop-filter: blur(4px); color: #fff; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: var(--radius-pill); }
  .disaster-content { padding: 0 18px; display: flex; flex-direction: column; gap: 8px; }
  .rescue-highlight-box {
    background: var(--safe-emerald-dim); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-sm);
    padding: 10px 14px; font-size: 13px; color: var(--safe-emerald); font-weight: 600; display: flex; justify-content: space-between; align-items: center;
  }

  /* BUTTONS & INPUTS */
  .btn { border: none; border-radius: var(--radius-md); padding: 14px 20px; font-weight: 700; font-size: 15px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; }
  .btn-block { width: 100%; }
  .btn-sos-main { background: linear-gradient(135deg, var(--sos-crimson) 0%, #C51E1E 100%); color: #FFFFFF; box-shadow: var(--shadow-glow-crimson); }
  .btn-safe-main { background: linear-gradient(135deg, var(--safe-emerald) 0%, #047857 100%); color: #FFFFFF; box-shadow: var(--shadow-glow-emerald); }
  .btn-outline { background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle); color: var(--text-primary); }

  .form-stack { display: flex; flex-direction: column; gap: 16px; }
  .input-text, .input-select, .input-textarea {
    width: 100%; background: var(--bg-surface-elevated); border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm); color: var(--text-primary); padding: 12px 14px; font-size: 14.5px; outline: none;
  }

  .toast-container { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 10000; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
  .toast-bubble { background: var(--bg-surface-elevated); color: var(--text-primary); border: 1px solid var(--border-strong); padding: 12px 20px; border-radius: var(--radius-pill); font-size: 13.5px; font-weight: 600; box-shadow: var(--shadow-card); pointer-events: auto; }

  #strobeOverlay { position: fixed; inset: 0; z-index: 99999; background: #fff; display: none; align-items: center; justify-content: center; cursor: pointer; }
  #strobeOverlay.flashing { display: flex; animation: strobeFlash 0.12s infinite; }
  @keyframes strobeFlash { 0%, 49% { background: #FFFFFF; } 50%, 100% { background: #000000; } }

  .footer-caption { text-align: center; font-size: 12px; color: var(--text-muted); padding: 24px 16px; border-top: 1px solid var(--border-subtle); margin-top: auto; }
</style>
</head>
<body>

<div id="strobeOverlay" onclick="toggleScreenStrobe(false)">
  <div style="background:rgba(0,0,0,0.85);color:#fff;padding:12px 24px;border-radius:30px;font-weight:700;">🚨 VISUAL SOS STROBE ACTIVE · TAP TO STOP</div>
</div>

<div class="page-wrapper">
  <div id="app-container">

    <!-- TOP BAR -->
    <header class="top-bar">
      <div class="brand-group" onclick="goLanding()">
        <div class="brand-logo-radar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2L3 7v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V7l-9-5z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
        </div>
        <div class="brand-title">BEACON <span class="brand-badge">LIVE OPS</span></div>
      </div>

      <div class="top-actions">
        <button class="icon-btn" id="voiceNavBtn" onclick="toggleGlobalVoiceNav()" title="Voice Nav Controls">🎙️</button>
        <button class="icon-btn" onclick="toggleWideMode()" title="Expand View">🖥️</button>
        <button class="icon-btn" onclick="toggleTheme()" title="Toggle Theme"><svg id="themeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle></svg></button>
      </div>
    </header>

    <!-- NAVIGATION TABS -->
    <nav class="nav-menu-bar">
      <button class="nav-tab active" id="tab-home" onclick="goLanding()">Home</button>
      <button class="nav-tab" id="tab-features" onclick="goFeatures()">Website Features</button>
      <button class="nav-tab" id="tab-impact" onclick="goImpact()">Contributions &amp; Rescues</button>
    </nav>

    <!-- TELEMETRY TICKER -->
    <div class="telemetry-bar">
      <div><span class="live-dot"></span> DISPATCH RADAR ONLINE</div>
      <div id="gpsTelemetry">GPS: STANDBY</div>
      <div id="activeRescuersTelemetry">VOLUNTEERS: DETECTING...</div>
    </div>

    <!-- =====================================================================
         PAGE 1: HOMEPAGE WITH 10,000+ RESCUED STAT
         ===================================================================== -->
    <main class="screen" id="screen-landing">
      <div class="hero-banner">
        <div class="crisis-pulse-tag"><span class="live-dot" style="background:#fff;"></span> CRISIS RESCUE NETWORK</div>
        <h1 class="screen-title">Get help. Give help.<br/><span style="color:var(--sos-crimson);">Fast.</span></h1>
        <p class="screen-lede" style="margin-top:8px;">
          Beacon instantly synchronizes trapped or injured people with local volunteer rescuers, calculating live routes, AI injury triage, and hospital maps.
        </p>
      </div>

      <!-- 10K PEOPLE RESCUED BANNER -->
      <div class="rescued-counter-banner">
        <div>
          <div class="rescued-number">10,840+</div>
          <div class="rescued-text"><b>Lives Saved &amp; Rescued</b> across 45 major global disaster zones</div>
        </div>
        <button class="pill-btn primary" onclick="goImpact()">View Report ↗</button>
      </div>

      <div class="choice-container">
        <button class="choice-card-pro sos-card" onclick="goVictim()">
          <div class="choice-header">
            <div class="choice-icon-wrap">🆘</div>
            <div>➔</div>
          </div>
          <div class="choice-title">Injured or Trapped</div>
          <div class="choice-desc">Broadcast emergency distress coordinates, AI damage photos, and lock on to nearest volunteer responder.</div>
        </button>

        <button class="choice-card-pro rescuer-card-entry" onclick="goRescuerEntry()">
          <div class="choice-header">
            <div class="choice-icon-wrap">🚑</div>
            <div>➔</div>
          </div>
          <div class="choice-title">Volunteer Rescuer</div>
          <div class="choice-desc">Register your medical equipment, go on standby, and respond to incoming crisis incidents in your perimeter.</div>
        </button>
      </div>
    </main>

    <!-- =====================================================================
         PAGE 2: PLATFORM FEATURES
         ===================================================================== -->
    <main class="screen hidden" id="screen-features">
      <div>
        <h1 class="screen-title">Platform Features</h1>
        <p class="screen-lede">Engineered for low-latency emergency dispatch under disrupted cellular networks and extreme disaster environments.</p>
      </div>

      <div class="feature-grid">
        <div class="feature-card">
          <div class="feature-icon">📍</div>
          <h3 style="font-size:16px;font-weight:700;">Sub-Meter Live GPS Radar</h3>
          <p style="font-size:13px;color:var(--text-secondary);">Real-time telemetry tracking with WebSockets and dynamic OpenStreetMap route polyline overlays.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🤖</div>
          <h3 style="font-size:16px;font-weight:700;">AI Injury &amp; Hazard Triage</h3>
          <p style="font-size:13px;color:var(--text-secondary);">Automated scoring scale evaluating physical entrapment, severe bleeding, and structural collapse threat levels.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🎙️</div>
          <h3 style="font-size:16px;font-weight:700;">Voice Navigation &amp; Commands</h3>
          <p style="font-size:13px;color:var(--text-secondary);">Hands-free Web Speech API integration allowing victims under rubble to dictate injuries or trigger distress signals.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🔊</div>
          <h3 style="font-size:16px;font-weight:700;">Acoustic Siren &amp; Screen Strobe</h3>
          <p style="font-size:13px;color:var(--text-secondary);">High-decibel dual-oscillator acoustic SOS sound waves paired with flashing screen light to signal search dogs.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🏥</div>
          <h3 style="font-size:16px;font-weight:700;">Overpass Hospital Finder</h3>
