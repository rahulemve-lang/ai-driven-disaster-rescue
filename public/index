<div class="toast-container" id="toastContainer"></div>

<script>
  const socket = io();

  let deviceId = null, myRescuerId = null, myRole = null, currentRequestId = null;
  let map2 = null, mapMarkers = {}, victimLoc = null, rescuerLoc = null;
  let globalVoiceRecognizer = null;

  function toast(msg) {
    const container = document.getElementById('toastContainer');
    const bubble = document.createElement('div');
    bubble.className = 'toast-bubble';
    bubble.textContent = msg;
    container.appendChild(bubble);
    setTimeout(() => bubble.remove(), 3000);
  }

  function show(id) { document.getElementById(id)?.classList.remove('hidden'); }
  function hide(id) { document.getElementById(id)?.classList.add('hidden'); }

  /* PAGE NAVIGATION TABS */
  function setTab(activeId) {
    ['tab-home', 'tab-features', 'tab-impact'].forEach(id => {
      document.getElementById(id)?.classList.remove('active');
    });
    document.getElementById(activeId)?.classList.add('active');
  }

  function goLanding() {
    ['screen-landing', 'screen-features', 'screen-impact', 'screen-rescuer-register', 'screen-rescuer-dash', 'screen-victim'].forEach(hide);
    show('screen-landing');
    setTab('tab-home');
  }

  function goFeatures() {
    ['screen-landing', 'screen-features', 'screen-impact', 'screen-rescuer-register', 'screen-rescuer-dash', 'screen-victim'].forEach(hide);
    show('screen-features');
    setTab('tab-features');
  }

  function goImpact() {
    ['screen-landing', 'screen-features', 'screen-impact', 'screen-rescuer-register', 'screen-rescuer-dash', 'screen-victim'].forEach(hide);
    show('screen-impact');
    setTab('tab-impact');
  }

  function goVictim() {
    ['screen-landing', 'screen-features', 'screen-impact', 'screen-rescuer-register', 'screen-rescuer-dash'].forEach(hide);
    show('screen-victim');
    myRole = 'victim';
    primeVictimLocation();
  }

  function goRescuerEntry() {
    ['screen-landing', 'screen-features', 'screen-impact', 'screen-victim', 'screen-rescuer-dash'].forEach(hide);
    show('screen-rescuer-register');
    myRole = 'rescuer';
  }

  function toggleWideMode() {
    document.getElementById('app-container').classList.toggle('wide-mode');
  }

  function toggleTheme() {
    const curr = document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', curr);
  }

  function toggleGlobalVoiceNav() {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) { toast('Voice Nav not supported'); return; }
    if (globalVoiceRecognizer) {
      globalVoiceRecognizer.stop(); globalVoiceRecognizer = null;
      toast('Voice Nav Off');
    } else {
      globalVoiceRecognizer = new SpeechRecognition();
      globalVoiceRecognizer.continuous = true;
      globalVoiceRecognizer.start();
      toast('🎙️ Voice Nav Active');
    }
  }

  function getLocation() {
    return new Promise((resolve) => {
      navigator.geolocation.getCurrentPosition(
        pos => resolve({ lat: pos.coords.latitude, lng: pos.coords.longitude }),
        () => resolve({ lat: 28.6139, lng: 77.2090 })
      );
    });
  }

  async function primeVictimLocation() { victimLoc = await getLocation(); }

  async function sendSOS() {
    if (!victimLoc) victimLoc = await getLocation();
    const id = 'req_' + Math.random().toString(36).slice(2, 8);
    const req = { id, lat: victimLoc.lat, lng: victimLoc.lng, injury: document.getElementById('v-injury').value, status: 'pending' };
    localStorage.setItem('requests:' + id, JSON.stringify(req));
    hide('victim-precall'); show('victim-tracking');
    toast('🚨 SOS Transmitted!');
  }

  function cancelSOS() {
    hide('victim-tracking'); show('victim-precall');
    toast('SOS Request Cancelled');
  }

  async function submitRescuerRegistration() {
    const name = document.getElementById('reg-name').value;
    if (!name) return toast('Please enter your name');
    hide('screen-rescuer-register'); show('screen-rescuer-dash');
    document.getElementById('rescuer-greeting').textContent = 'Welcome, ' + name;
    toast('Rescuer Registered!');
  }

  window.addEventListener('DOMContentLoaded', () => { goLanding(); });
</script>
</body>
