    <!-- =====================================================================
         SCREEN: RESCUER REGISTRATION & DASHBOARD
         ===================================================================== -->
    <div class="screen hidden" id="screen-rescuer-register">
      <button class="pill-btn" onclick="goLanding()">← Back</button>
