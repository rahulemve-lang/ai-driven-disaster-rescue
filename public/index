        <div style="font-size:18px;font-weight:800;color:var(--sos-crimson);">🚨 DISPATCH ACTIVE</div>
        <div id="statusLabel">Locating responders...</div>
        <div id="map2" style="width:100%;height:280px;border-radius:14px;background:#0d131f;"></div>
        <button class="btn btn-outline btn-block" onclick="cancelSOS()">Cancel Request</button>
